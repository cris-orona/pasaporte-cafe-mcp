{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "hosted/bin/pasaporte-cafe-mcp"
    }
  },
  "rewrites": [
    { "source": "/pasaporte/mcp", "destination": "/api/index" },
    { "source": "/.well-known/oauth-protected-resource/pasaporte/mcp", "destination": "/api/index" }
  ]
}
